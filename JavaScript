const gameContainer = document.getElementById('game-container');
const scoreElement = document.getElementById('score');

let score = 0;
let gameOver = false;
let gameSpeed = 4;

// إنشاء سيارة اللاعب برمجياً
const player = document.createElement('div');
player.style.position = 'absolute';
player.style.width = '45px';
player.style.height = '85px';
player.style.backgroundColor = '#ff3333'; // لون سيارة اللاعب (أحمر)
player.style.bottom = '20px';
player.style.left = '135px';
player.style.borderRadius = '8px';
player.style.boxShadow = '0 0 10px rgba(0,0,0,0.5)';
gameContainer.appendChild(player);

let playerX = 135;

// التحكم بالحركة عبر أزرار الكيبورد
document.addEventListener('keydown', (e) => {
  if (gameOver) return;
  if (e.key === 'ArrowLeft' && playerX > 15) {
    playerX -= 25;
  } else if (e.key === 'ArrowRight' && playerX < 260) {
    playerX += 25;
  }
  player.style.left = playerX + 'px';
});

// إنشاء سيارة العدو والمنافس برمجياً
const enemy = document.createElement('div');
enemy.style.position = 'absolute';
enemy.style.width = '45px';
enemy.style.height = '85px';
enemy.style.backgroundColor = '#3366ff'; // لون سيارة المنافس (أزرق)
enemy.style.top = '-100px';
enemy.style.left = Math.floor(Math.random() * 245) + '15px';
enemy.style.borderRadius = '8px';
gameContainer.appendChild(enemy);

let enemyY = -100;
let enemyX = Math.floor(Math.random() * 245) + 15;
enemy.style.left = enemyX + 'px';

// تحريك خطوط الطريق لإعطاء شعور بالحركة
const roadLines = document.querySelectorAll('.road-line');

function updateRoad() {
  roadLines.forEach(line => {
    let currentTop = parseInt(line.style.top);
    currentTop += gameSpeed;
    if (currentTop > 500) currentTop = -60;
    line.style.top = currentTop + 'px';
  });
}

// حلقة اللعبة الأساسية (Game Loop)
function gameLoop() {
  if (gameOver) return;

  updateRoad();

  // تحريك سيارة المنافس للأسفل
  enemyY += gameSpeed;
  if (enemyY > 500) {
    enemyY = -100;
    enemyX = Math.floor(Math.random() * 245) + 15; // تغيير مكان ظهور العدو عشوائياً
    enemy.style.left = enemyX + 'px';
    score += 10;
    scoreElement.innerText = score;
    gameSpeed += 0.2; // زيادة السرعة تدريجياً مع زيادة النقاط
  }
  enemy.style.top = enemyY + 'px';

  // فحص الاصطدام بدقة بين سيارتك وسيارة المنافس
  const pRect = player.getBoundingClientRect();
  const eRect = enemy.getBoundingClientRect();

  if (
    pRect.left < eRect.right &&
    pRect.right > eRect.left &&
    pRect.top < eRect.bottom &&
    pRect.bottom > eRect.top
  ) {
    gameOver = true;
    alert('انتهت اللعبة! مجموع نقاطك: ' + score);
    window.location.reload(); // إعادة تشغيل اللعبة تلقائياً
  }

  requestAnimationFrame(gameLoop);
}

// بدء تشغيل اللعبة
gameLoop();
